# ══════════════════════════════════════════════════════════════════════════════
#  Root .gitignore — sample_application (monorepo)
#  Covers: Node/TypeScript, React/Vite, Docker, GCP, macOS, editors
# ══════════════════════════════════════════════════════════════════════════════

# ── Dependencies ──────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
.next/
.nuxt/
.output/

# Backend compiled TypeScript
backend/dist/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*.local

# GCP service account key files — NEVER commit these
*.json.key
*-key.json
gcp-key*.json
service-account*.json

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Runtime & cache ───────────────────────────────────────────────────────────
.cache/
.parcel-cache/
.vite/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ── Testing ───────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/

# ── Docker ────────────────────────────────────────────────────────────────────
# (Dockerfiles themselves are committed; ignore local override compose files)
docker-compose.override.yml
.docker/

# ── GCP / Google Cloud ────────────────────────────────────────────────────────
# Application Default Credentials written by `gcloud auth application-default login`
application_default_credentials.json
.gcloud/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon\r

# ── Editors & IDEs ───────────────────────────────────────────────────────────
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# JetBrains (WebStorm, IntelliJ)
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.#*

# Sublime Text
*.sublime-workspace

# ── Miscellaneous ─────────────────────────────────────────────────────────────
*.local
.history/
*.orig
*.rej
